<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="WpfApp1.MasalarEkrani"
        mc:Ignorable="d"
        Title="Masalar Yönetim Ekranı" Height="1080" Width="1920" WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="bb_adisyon_v3_64px.ico" Cursor="Cross">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Overlay="bb_adisyon_v3_64px.ico"/>
    </Window.TaskbarItemInfo>
    <Grid>
        <DataGrid HorizontalAlignment="Left" Height="1049" VerticalAlignment="Top" Width="544" x:Name="dg_1" CanUserAddRows="False" ColumnWidth="*" IsReadOnly="True"/>
        <TextBox HorizontalAlignment="Left" Height="37" Margin="723,32,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="138" x:Name="MasaID_TxtBox"/>
        <TextBox HorizontalAlignment="Left" Height="37" Margin="723,108,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="138" x:Name="MasaAdi_TxtBox"/>
        <Label Content="MasaID" HorizontalAlignment="Left" Margin="723,10,0,0" VerticalAlignment="Top"/>
        <Label Content="Masa Adı" HorizontalAlignment="Left" Margin="723,86,0,0" VerticalAlignment="Top"/>
        <Button Content="Masa Ekle" HorizontalAlignment="Left" Margin="738,160,0,0" VerticalAlignment="Top" Width="111" x:Name="Ekle_Button" Click="Ekle_Button_Click"/>
        <Button Content="Seçili Masayı Sil" HorizontalAlignment="Left" Margin="738,236,0,0" VerticalAlignment="Top" Width="111" x:Name="Sil_Button" Click="Sil_Button_Click"/>
        <Image Margin="1212,32,34,310" Source="29630cc9-1e1c-428f-b174-e25a8e874495.png" Stretch="Fill"/>
        <Label Content="Masa eklemek için lütfen masaya ait masa adını ve masa ID bilgisini giriniz ve butona tıklayınız." HorizontalAlignment="Left" Margin="619,187,0,0" VerticalAlignment="Top" FontSize="9"/>
        <Label Content="Masa silmek için lütfen listeden silmek istediğiniz masayı seçiniz ve butona tıklayınız." HorizontalAlignment="Left" Margin="634,263,0,0" VerticalAlignment="Top" FontSize="9"/>
        <Image HorizontalAlignment="Left" Height="19" Margin="600,187,0,0" VerticalAlignment="Top" Width="19" Source="{dx:DXImage SvgImages/Icon Builder/Actions_AddCircled.svg}"/>
        <Image HorizontalAlignment="Left" Height="15" Margin="619,264,0,0" VerticalAlignment="Top" Width="18" Source="{dx:DXImage SvgImages/HybridDemoIcons/BottomPanel/HybridDemo_Delete.svg}"/>

    </Grid>
</Window>
