<Window x:Class="WpfApp1.Urunler"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Ürünler Paneli" Height="768" Width="1366" Icon="bb_adisyon_v3_64px.ico" Cursor="Cross">
    <Grid>
        <DataGrid HorizontalAlignment="Left" Height="727" VerticalAlignment="Top" Width="349" Name="Urunlerdg" AutoGenerateColumns="True" AutoGeneratingColumn="Masalar_Grid_AutoGeneratingColumn" ColumnWidth="*" IsReadOnly="True" CanUserAddRows="False"/>
        <TextBox HorizontalAlignment="Left" Height="37" Margin="368,56,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="202" Name="UrunAdi_TxtBox"/>
        <TextBox HorizontalAlignment="Left" Height="37" Margin="368,140,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="202" x:Name="Fiyat_TxtBox"/>
        <Label Content="Ürün Adı" HorizontalAlignment="Left" Margin="368,29,0,0" VerticalAlignment="Top"/>
        <Label Content="Ürün Fiyatı" HorizontalAlignment="Left" Margin="368,118,0,0" VerticalAlignment="Top"/>
        <Button Content="Ürün Ekle" HorizontalAlignment="Left" Margin="414,194,0,0" VerticalAlignment="Top" Width="101" Height="31" Name="UrunEkle_Button" Click="UrunEkle_Button_Click"/>
        <Button Content="Ürün Sil" HorizontalAlignment="Left" Margin="414,233,0,0" VerticalAlignment="Top" Width="101" Height="31" x:Name="UrunSil_Button" Click="UrunSil_Button_Click"/>
        <Image Margin="575,0,10,10" Source="29630cc9-1e1c-428f-b174-e25a8e874495.png" Stretch="Fill"/>

    </Grid>
</Window>
