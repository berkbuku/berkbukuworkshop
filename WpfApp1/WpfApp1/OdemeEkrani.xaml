<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="WpfApp1.OdemeEkrani"
        mc:Ignorable="d"
        Title="Ödeme Ekranı" Height="1080" Width="1920" WindowStartupLocation="CenterScreen" Icon="bb_adisyon_v3_64px.ico" SizeToContent="WidthAndHeight" WindowState="Maximized" Cursor="Cross">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="441*"/>
            <ColumnDefinition Width="86*"/>
            <ColumnDefinition Width="11*"/>
            <ColumnDefinition Width="102*"/>
        </Grid.ColumnDefinitions>
        <DataGrid HorizontalAlignment="Left" Height="568" VerticalAlignment="Top" Width="462" x:Name="Masalar_Grid" AutoGenerateColumns="True" IsReadOnly="True" ColumnWidth="*" AutoGeneratingColumn="Masalar_Grid_AutoGeneratingColumn" CanUserAddRows="False"/>
        <ComboBox HorizontalAlignment="Left" Margin="572,66,0,0" VerticalAlignment="Top" Width="218" Height="40" x:Name="UrunAdi_ComboBox" SelectionChanged="UrunAdi_ComboBox_SelectionChanged">
            <ComboBox Width="120"/>
        </ComboBox>
        <ComboBox HorizontalAlignment="Left" Margin="816,66,0,0" VerticalAlignment="Top" Width="218" Height="40" x:Name="UrunMiktari_ComboBox">
            <ComboBox Width="120"/>
        </ComboBox>
        <Label Content="Ürünler" HorizontalAlignment="Left" Margin="572,39,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Ürün Miktarı" HorizontalAlignment="Left" Margin="816,39,0,0" VerticalAlignment="Top" FontSize="16"/>
        <ListBox HorizontalAlignment="Left" Height="558" Margin="107,10,0,0" VerticalAlignment="Top" Width="482" x:Name="Sepet_ListBox" Grid.ColumnSpan="3" Grid.Column="1"/>
        <Button Content="Ürünü Onayla" HorizontalAlignment="Left" Margin="864,135,0,0" VerticalAlignment="Top" Width="123" Height="37" x:Name="UrunOnayla_Button" Click="UrunOnayla_Button_Click"/>
        <ComboBox HorizontalAlignment="Left" Margin="1053,66,0,0" VerticalAlignment="Top" Width="218" Height="40" x:Name="OdemeSecenekleri_ComboBox">
            <ComboBox Width="120"/>
        </ComboBox>
        <Label Content="Ödeme Seçenekleri" HorizontalAlignment="Left" Margin="1053,34,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="" HorizontalAlignment="Left" Margin="47,576,0,0" VerticalAlignment="Top" FontSize="16" x:Name="labelToplamTutar" Width="252" Height="37" Grid.Column="3"/>
        <Button Content="Sepetteki Ürünlerin Ödemesini Al" HorizontalAlignment="Left" Margin="107,576,0,0" VerticalAlignment="Top" Width="206" Height="37" x:Name="OdemeAl_Button" Click="OdemeAl_Button_Click" Grid.ColumnSpan="3" Grid.Column="1"/>
        <Image Margin="572,614,250,10" Source="29630cc9-1e1c-428f-b174-e25a8e874495.png" Stretch="Fill" Grid.ColumnSpan="2"/>
        <Label Content="Ürünleri sepete ekleyebilmek için adisyondaki ürünlerden seçilen ürün,miktarı ve ödeme yöntemi seçilmiş olmalıdır!" HorizontalAlignment="Left" Margin="662,176,0,0" VerticalAlignment="Top" Foreground="Red"/>
        <Image HorizontalAlignment="Left" Height="22" Margin="639,176,0,0" VerticalAlignment="Top" Width="32" Source="{dx:DXImage SvgImages/Icon Builder/Security_WarningCircled1.svg}"/>
        <Image HorizontalAlignment="Left" Height="33" Margin="107,621,0,0" VerticalAlignment="Top" Width="24" Source="{dx:DXImage SvgImages/Icon Builder/Business_DollarCircled.svg}" Grid.Column="1"/>
        <Label Content="Sepete eklenen ürünlerin ödemesini almak için tıklayınız." HorizontalAlignment="Left" Margin="131,620,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3" Foreground="#FF2CAA32" Grid.Column="1"/>
        <TextBox HorizontalAlignment="Left" Height="38" Margin="720,264,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="218" Name="Miktar_TxtBox"/>
        <Label Content="Ödenecek Miktar" HorizontalAlignment="Left" Margin="721,237,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="964,264,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="38" Width="186" Name="Toplam_TextBlock"/>
        <TextBlock HorizontalAlignment="Left" Margin="964,307,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="38" Width="186" x:Name="Odenen_TextBlock"/>
        <TextBlock HorizontalAlignment="Left" Margin="964,350,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="38" Width="186" x:Name="Kalan_TextBlock"/>
        <ComboBox HorizontalAlignment="Left" Margin="720,350,0,0" VerticalAlignment="Top" Width="218" Height="40" x:Name="OdemeSecenekleri_ComboBox_Copy">
            <ComboBox Width="120"/>
        </ComboBox>
        <Label Content="Ödeme Seçenekleri" HorizontalAlignment="Left" Margin="720,318,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Button Content="Miktar ile Ödeme Al" HorizontalAlignment="Left" Margin="752,415,0,0" VerticalAlignment="Top" Width="139" Height="40" Name="MiktarOdemeAl_Button" Click="MiktarOdemeAl_Button_Click"/>
        <Image HorizontalAlignment="Left" Height="33" Margin="694,461,0,0" VerticalAlignment="Top" Width="24" Source="{dx:DXImage SvgImages/Icon Builder/Business_DollarCircled.svg}"/>
        <Label Content="Hesap tutarı ile ödeme almak için tıklayınız." HorizontalAlignment="Left" Margin="718,460,0,0" VerticalAlignment="Top" Foreground="#FF2CAA32"/>

    </Grid>
</Window>
