        <Label Content="Seçili masanın ödemesini almak için tıklayınız." HorizontalAlignment="Left" Margin="582,245,0,0" VerticalAlignment="Top" Grid.Column="1" Height="21" FontSize="9" Foreground="#FF00C91B" Width="180"/>
