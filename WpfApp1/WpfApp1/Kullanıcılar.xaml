<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="WpfApp1.Kullanıcılar"
        mc:Ignorable="d"
        Title="Kullanıcılar Yönetim Ekranı" Height="1080" Width="1920" WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="bb_adisyon_v3_64px.ico" Cursor="Cross">
    <Grid>
        <DataGrid HorizontalAlignment="Left" Height="1029" Margin="0,10,0,0" VerticalAlignment="Top" Width="560" x:Name="dg_1" CanUserAddRows="False" ColumnWidth="*" IsReadOnly="True"/>
        <TextBox HorizontalAlignment="Left" Height="42" Margin="854,41,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="174" x:Name="K_Adi_TxtBox"/>
        <TextBox HorizontalAlignment="Left" Height="42" Margin="854,128,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="174" x:Name="Sifre_TxtBox"/>
        <TextBox HorizontalAlignment="Left" Height="42" Margin="854,220,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="174" x:Name="Rol_TxtBox"/>
        <Label Content="Kullanıcı Adı" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="854,19,0,0"/>
        <Label Content="Şifre" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="854,106,0,0"/>
        <Label Content="Rol" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="854,198,0,0" RenderTransformOrigin="1,1.864"/>
        <Button Content="Kullanıcı Ekle" HorizontalAlignment="Left" Margin="867,294,0,0" VerticalAlignment="Top" Width="151" Height="42" x:Name="KullanıcıEkle_Button" Click="KullanıcıEkle_Button_Click"/>
        <Button Content="Seçili Kullanıcıyı Sil" HorizontalAlignment="Left" Margin="867,387,0,0" VerticalAlignment="Top" Width="151" Height="42" x:Name="KullanıcıSil_Button" Click="KullanıcıSil_Button_Click"/>
        <Image Margin="565,522,565,0" Source="29630cc9-1e1c-428f-b174-e25a8e874495.png" Stretch="Fill"/>
        <Label Content="Yeni kullanıcı eklemek için lütfen kullanıcının bilgilerini giriniz ve butona tıklayınız." HorizontalAlignment="Left" Margin="769,341,0,0" VerticalAlignment="Top"/>
        <Image HorizontalAlignment="Left" Height="33" Margin="743,339,0,0" VerticalAlignment="Top" Width="26" Source="{dx:DXImage SvgImages/Outlook Inspired/NewCustomer.svg}"/>
        <Label Content="Kullanıcı silmek için lütfen listeden silinecek kullanıcıyı seçiniz ve butona tıklayınız." HorizontalAlignment="Left" Margin="767,434,0,0" VerticalAlignment="Top"/>
        <Image HorizontalAlignment="Left" Height="25" Margin="743,434,0,0" VerticalAlignment="Top" Width="26" Source="{dx:DXImage SvgImages/Icon Builder/Actions_RemoveCircled.svg}"/>
        <DataGrid HorizontalAlignment="Left" Height="1029" Margin="1352,10,0,0" VerticalAlignment="Top" Width="560" x:Name="dg_2" CanUserAddRows="False" ColumnWidth="*" IsReadOnly="True"/>

    </Grid>
